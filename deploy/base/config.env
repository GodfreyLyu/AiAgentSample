ENVIRONMENT=production
LOG_LEVEL=INFO
LOGFIRE_SEND_TO_LOGFIRE=false
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_MODE=responses
AGENT_WORKSPACE_ROOT=/workspace
AGENT_COMMAND_ENABLED=false
AGENT_ALLOWED_COMMANDS=python,python3
AGENT_COMMAND_TIMEOUT_SECONDS=10
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_MAX_FILE_SIZE_BYTES=1000000
AGENT_MAX_COMMAND_OUTPUT_CHARS=50000
AGENT_REQUEST_LIMIT=12
AGENT_TOOL_CALLS_LIMIT=30
AGENT_TOTAL_TOKENS_LIMIT=80000
AGENT_MAX_CONCURRENCY=10
SESSION_TTL_SECONDS=3600
SESSION_MAX_COUNT=1000
