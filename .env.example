# Model provider
DP_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_MODE=responses

# Protect agent endpoints in any shared environment
API_BEARER_TOKEN=replace-with-a-long-random-token

# Agent runtime
AGENT_WORKSPACE_ROOT=./workspace
AGENT_COMMAND_ENABLED=true
AGENT_ALLOWED_COMMANDS=python,python3,pytest,ruff
AGENT_COMMAND_TIMEOUT_SECONDS=10
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_MAX_CONCURRENCY=10

# Conversation history is process-local until a shared store is added
SESSION_TTL_SECONDS=3600
SESSION_MAX_COUNT=1000

# Observability
LOG_LEVEL=INFO
LOGFIRE_SEND_TO_LOGFIRE=false

